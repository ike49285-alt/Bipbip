__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# The bar archive IS committed on purpose. Free providers serve only a
# trailing ~30-day window, so the scheduled collector accumulating history in
# git is the whole mechanism by which this project ever gets a usable sample.
# Parquet keeps it small: roughly 20KB per symbol per session.
data/bars/*.csv

# Earnings dates and sector labels are committed for the same reason as
# the bar archive: so backtests run without a network round trip.
!data/fundamentals/

# Backtest output
out/
*.log

# Never commit broker credentials
secrets.yaml
credentials.json
